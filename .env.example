# QueryMind environment configuration
# Copy this file to .env and fill in your values before running the app.
# Never commit .env to version control.

# ----------------------------------------------------------------------
# AI Provider Selection
# Choose one: gemini, openrouter, ollama
# ----------------------------------------------------------------------
AI_PROVIDER=gemini

# ----------------------------------------------------------------------
# Google Gemini (free tier available)
# Get a key from https://aistudio.google.com/
# ----------------------------------------------------------------------
GEMINI_API_KEY=
# Set to a model enabled for your API key. See Google GenAI client.models.list().
GEMINI_MODEL=gemini-3.8-flash

# ----------------------------------------------------------------------
# OpenRouter (access to many free models incl. OpenCode-style models)
# Get a free key from https://openrouter.ai/
# Free models: openrouter/auto, meta-llama/llama-3.1-8b-instruct:free,
#              google/gemma-2-9b-it:free, microsoft/phi-3-mini-128k-instruct:free
# ----------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# ----------------------------------------------------------------------
# Ollama (local, completely free — run models on your own machine)
# Install Ollama from https://ollama.com/, then run:
#   ollama pull llama3.1:8b
# ----------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ----------------------------------------------------------------------
# OpenAI-compatible provider (OpenCode models like Nemotron 3.5 Super VL Free)
# Use with NVIDIA API Catalog, OpenRouter, Together, Groq, etc.
# Get a free key from https://build.nvidia.com (NVIDIA API Catalog)
#   Nemotron 3.5 Super VL Free: nemotron-3.5-super-vl-free
#   Nemotron 3.5 Super 49B: nemotron-3.5-super-49b-v1
# Example base URL: https://integrate.api.nvidia.com/v1
# ----------------------------------------------------------------------
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=nemotron-3.5-super-vl-free

# ----------------------------------------------------------------------
# MySQL connection settings
# ----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=querymind_db
DB_USER=querymind_app
DB_PASSWORD=

# ----------------------------------------------------------------------
# MySQL admin credentials (for database listing / switching only)
# Needed to list available databases and switch between them.
# Use root or a user with SHOW DATABASES privilege.
# ----------------------------------------------------------------------
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
